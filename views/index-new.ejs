<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .sidebar {
            min-height: 100vh;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        .sidebar .nav-link {
            color: rgba(255,255,255,0.8);
        }
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            color: white;
            background-color: rgba(255,255,255,0.1);
        }
        .stats-card {
            border-left: 4px solid #667eea;
        }
        .main-content {
            min-height: 100vh;
        }
        .dashboard-card {
            transition: transform 0.2s;
        }
        .dashboard-card:hover {
            transform: translateY(-2px);
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-2 sidebar p-3">
                <h4 class="text-white mb-4">
                    <i class="fas fa-book"></i> Story Planner
                </h4>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link active" href="/">
                            <i class="fas fa-home"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/story/settings">
                            <i class="fas fa-cog"></i> Story Settings
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/characters">
                            <i class="fas fa-users"></i> Characters
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/locations">
                            <i class="fas fa-map-marker-alt"></i> Locations
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/lore">
                            <i class="fas fa-scroll"></i> Lore
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/events">
                            <i class="fas fa-calendar-alt"></i> Events
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/relationships">
                            <i class="fas fa-heart"></i> Relationships
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/timeline">
                            <i class="fas fa-clock"></i> Timeline
                        </a>
                    </li>
                    <hr class="text-white">
                    <li class="nav-item">
                        <a class="nav-link" href="/export">
                            <i class="fas fa-download"></i> Export
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/import">
                            <i class="fas fa-upload"></i> Import
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Main Content -->
            <div class="col-md-10 main-content">
                <nav class="navbar navbar-light bg-light">
                    <div class="container-fluid">
                        <span class="navbar-brand mb-0 h1">
                            <% if (story.story_title) { %>
                                <%= story.story_title %>
                            <% } else { %>
                                Welcome to Story Planner
                            <% } %>
                        </span>
                        <% if (story.story_title) { %>
                            <a href="/story/settings" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-edit"></i> Edit Story Info
                            </a>
                        <% } %>
                    </div>
                </nav>

                <div class="container-fluid p-4">
                    <% if (!story.story_title) { %>
                        <!-- Welcome screen for new users -->
                        <div class="row justify-content-center">
                            <div class="col-md-8 text-center">
                                <h1 class="display-4 mb-4">Welcome to Story Planner</h1>
                                <p class="lead mb-4">
                                    Your comprehensive tool for planning and tracking complex stories with intricate character relationships and evolving plotlines.
                                </p>
                                <a href="/story/settings" class="btn btn-primary btn-lg me-3">
                                    <i class="fas fa-plus"></i> Start a New Story
                                </a>
                                <a href="/import" class="btn btn-outline-secondary btn-lg">
                                    <i class="fas fa-upload"></i> Import Existing Story
                                </a>
                            </div>
                        </div>
                    <% } else { %>
                        <!-- Dashboard for existing story -->
                        <div class="row mb-4">
                            <div class="col-md-12">
                                <% if (story.metadata && story.metadata.description) { %>
                                    <p class="text-muted"><%= story.metadata.description %></p>
                                <% } %>
                            </div>
                        </div>

                        <!-- Stats Cards -->
                        <div class="row mb-4">
                            <div class="col-md-3">
                                <div class="card stats-card dashboard-card">
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            <i class="fas fa-users text-primary"></i> Characters
                                        </h5>
                                        <h3 class="card-text"><%= totalCharacters %></h3>
                                        <a href="/characters" class="btn btn-sm btn-outline-primary">Manage</a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card stats-card dashboard-card">
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            <i class="fas fa-calendar-alt text-success"></i> Events
                                        </h5>
                                        <h3 class="card-text"><%= totalEvents %></h3>
                                        <a href="/events" class="btn btn-sm btn-outline-success">Manage</a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card stats-card dashboard-card">
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            <i class="fas fa-map-marker-alt text-warning"></i> Locations
                                        </h5>
                                        <h3 class="card-text"><%= totalLocations %></h3>
                                        <a href="/locations" class="btn btn-sm btn-outline-warning">Manage</a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card stats-card dashboard-card">
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            <i class="fas fa-scroll text-info"></i> Lore Entries
                                        </h5>
                                        <h3 class="card-text"><%= totalLore %></h3>
                                        <a href="/lore" class="btn btn-sm btn-outline-info">Manage</a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Quick Actions -->
                        <div class="row mb-4">
                            <div class="col-md-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5><i class="fas fa-bolt"></i> Quick Actions</h5>
                                    </div>
                                    <div class="card-body">
                                        <a href="/characters/new" class="btn btn-primary me-2">
                                            <i class="fas fa-user-plus"></i> Add Character
                                        </a>
                                        <a href="/events/new" class="btn btn-success me-2">
                                            <i class="fas fa-plus"></i> Add Event
                                        </a>
                                        <a href="/locations/new" class="btn btn-warning me-2">
                                            <i class="fas fa-map-pin"></i> Add Location
                                        </a>
                                        <a href="/lore/new" class="btn btn-info me-2">
                                            <i class="fas fa-scroll"></i> Add Lore
                                        </a>
                                        <a href="/timeline" class="btn btn-outline-dark">
                                            <i class="fas fa-clock"></i> View Timeline
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Recent Events -->
                        <% if (events.length > 0) { %>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="card">
                                        <div class="card-header d-flex justify-content-between align-items-center">
                                            <h5><i class="fas fa-clock"></i> Recent Events</h5>
                                            <a href="/events" class="btn btn-sm btn-outline-primary">View All Events</a>
                                        </div>
                                        <div class="card-body">
                                            <% events.forEach(function(event) { %>
                                                <div class="border-start border-3 border-primary ps-3 mb-3">
                                                    <h6 class="mb-1">
                                                        <%= event.title || event.description.substring(0, 50) + '...' %>
                                                    </h6>
                                                    <small class="text-muted">
                                                        <i class="fas fa-calendar"></i> <%= new Date(event.timestamp).toLocaleDateString() %>
                                                        <% if (event.participants && event.participants.length > 0) { %>
                                                            | <i class="fas fa-users"></i> <%= event.participants.length %> participants
                                                        <% } %>
                                                    </small>
                                                    <p class="text-muted small mt-1">
                                                        <%= event.description.substring(0, 100) %>
                                                        <% if (event.description.length > 100) { %>...<% } %>
                                                    </p>
                                                </div>
                                            <% }); %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
