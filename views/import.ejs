<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Import Story</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .sidebar {
            min-height: 100vh;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        .sidebar .nav-link {
            color: rgba(255,255,255,0.8);
        }
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            color: white;
            background-color: rgba(255,255,255,0.1);
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-2 sidebar p-3">
                <h4 class="text-white mb-4">
                    <i class="fas fa-book"></i> Story Planner
                </h4>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            <i class="fas fa-home"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/story/settings">
                            <i class="fas fa-cog"></i> Story Settings
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/characters">
                            <i class="fas fa-users"></i> Characters
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/locations">
                            <i class="fas fa-map-marker-alt"></i> Locations
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/lore">
                            <i class="fas fa-scroll"></i> Lore
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/events">
                            <i class="fas fa-calendar-alt"></i> Events
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/relationships">
                            <i class="fas fa-heart"></i> Relationships
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/timeline">
                            <i class="fas fa-clock"></i> Timeline
                        </a>
                    </li>
                    <hr class="text-white">
                    <li class="nav-item">
                        <a class="nav-link" href="/export">
                            <i class="fas fa-download"></i> Export
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/import">
                            <i class="fas fa-upload"></i> Import
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Main Content -->
            <div class="col-md-10">
                <nav class="navbar navbar-light bg-light">
                    <div class="container-fluid">
                        <span class="navbar-brand mb-0 h1">Import Story</span>
                        <a href="/" class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-arrow-left"></i> Back to Dashboard
                        </a>
                    </div>
                </nav>

                <div class="container-fluid p-4">
                    <div class="row justify-content-center">
                        <div class="col-md-8">
                            <% if (typeof error !== 'undefined') { %>
                                <div class="alert alert-danger">
                                    <i class="fas fa-exclamation-triangle"></i>
                                    <strong>Import Error:</strong> <%= error %>
                                </div>
                            <% } %>

                            <div class="card">
                                <div class="card-header">
                                    <h5><i class="fas fa-upload"></i> Import Existing Story Data</h5>
                                </div>
                                <div class="card-body">
                                    <p class="text-muted mb-4">
                                        You can import an existing Story Planner JSON file (such as the demo_story.json) to load your story data.
                                        This will replace your current story data.
                                    </p>

                                    <form method="POST" action="/import">
                                        <div class="mb-3">
                                            <label for="jsonData" class="form-label">Story JSON Data *</label>
                                            <textarea class="form-control" id="jsonData" name="jsonData" rows="15" 
                                                      placeholder='Paste your story JSON data here...' required></textarea>
                                            <div class="form-text">
                                                Paste the contents of your story JSON file here. Make sure it's valid JSON format.
                                            </div>
                                        </div>

                                        <div class="alert alert-warning">
                                            <i class="fas fa-exclamation-triangle"></i>
                                            <strong>Warning:</strong> Importing will replace all existing story data. Make sure to export your current story first if you want to keep it.
                                        </div>

                                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                            <a href="/" class="btn btn-outline-secondary me-md-2">Cancel</a>
                                            <button type="submit" class="btn btn-primary">
                                                <i class="fas fa-upload"></i> Import Story
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>

                            <div class="card mt-4">
                                <div class="card-header">
                                    <h5><i class="fas fa-info-circle"></i> How to Import</h5>
                                </div>
                                <div class="card-body">
                                    <ol>
                                        <li>Export your current story data first (if you want to keep it)</li>
                                        <li>Open your story JSON file in a text editor</li>
                                        <li>Copy all the contents</li>
                                        <li>Paste them into the text area above</li>
                                        <li>Click "Import Story"</li>
                                    </ol>

                                    <div class="mt-3">
                                        <strong>Compatible formats:</strong>
                                        <ul>
                                            <li>Story Planner export files</li>
                                            <li>Legacy demo_story.json format</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
