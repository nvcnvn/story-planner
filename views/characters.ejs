<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Characters</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .sidebar {
            min-height: 100vh;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        .sidebar .nav-link {
            color: rgba(255,255,255,0.8);
        }
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            color: white;
            background-color: rgba(255,255,255,0.1);
        }
        .character-card {
            transition: transform 0.2s;
        }
        .character-card:hover {
            transform: translateY(-2px);
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-2 sidebar p-3">
                <h4 class="text-white mb-4">
                    <i class="fas fa-book"></i> Story Planner
                </h4>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            <i class="fas fa-home"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/story/settings">
                            <i class="fas fa-cog"></i> Story Settings
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/characters">
                            <i class="fas fa-users"></i> Characters
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/locations">
                            <i class="fas fa-map-marker-alt"></i> Locations
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/lore">
                            <i class="fas fa-scroll"></i> Lore
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/events">
                            <i class="fas fa-calendar-alt"></i> Events
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/relationships">
                            <i class="fas fa-heart"></i> Relationships
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/timeline">
                            <i class="fas fa-clock"></i> Timeline
                        </a>
                    </li>
                    <hr class="text-white">
                    <li class="nav-item">
                        <a class="nav-link" href="/export">
                            <i class="fas fa-download"></i> Export
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/import">
                            <i class="fas fa-upload"></i> Import
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Main Content -->
            <div class="col-md-10">
                <nav class="navbar navbar-light bg-light">
                    <div class="container-fluid">
                        <span class="navbar-brand mb-0 h1">Characters</span>
                        <a href="/characters/new" class="btn btn-primary btn-sm">
                            <i class="fas fa-plus"></i> Add Character
                        </a>
                    </div>
                </nav>

                <div class="container-fluid p-4">
                    <% if (characters.length === 0) { %>
                        <div class="text-center py-5">
                            <i class="fas fa-users fa-3x text-muted mb-3"></i>
                            <h3 class="text-muted">No Characters Yet</h3>
                            <p class="text-muted">Create your first character to start building your story.</p>
                            <a href="/characters/new" class="btn btn-primary">
                                <i class="fas fa-plus"></i> Add Your First Character
                            </a>
                        </div>
                    <% } else { %>
                        <div class="row">
                            <% characters.forEach(function(character) { %>
                                <div class="col-md-6 col-lg-4 mb-4">
                                    <div class="card character-card h-100">
                                        <div class="card-header d-flex justify-content-between align-items-center">
                                            <h5 class="mb-0"><%= character.name %></h5>
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                    <i class="fas fa-ellipsis-v"></i>
                                                </button>
                                                <ul class="dropdown-menu">
                                                    <li><a class="dropdown-item" href="/characters/<%= character.id %>/edit">
                                                        <i class="fas fa-edit"></i> Edit
                                                    </a></li>
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <form method="POST" action="/characters/<%= character.id %>/delete" style="display: inline;">
                                                            <button class="dropdown-item text-danger" type="submit" 
                                                                    onclick="return confirm('Are you sure you want to delete this character?')">
                                                                <i class="fas fa-trash"></i> Delete
                                                            </button>
                                                        </form>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                        <div class="card-body">
                                            <p class="card-text text-muted small"><%= character.description %></p>
                                            
                                            <div class="mt-3">
                                                <h6>Attributes:</h6>
                                                <% if (character.attributes && character.attributes.static) { %>
                                                    <% Object.keys(character.attributes.static).forEach(function(key) { %>
                                                        <% if (character.attributes.static[key]) { %>
                                                            <span class="badge bg-secondary me-1 mb-1">
                                                                <%= key %>: <%= character.attributes.static[key] %>
                                                            </span>
                                                        <% } %>
                                                    <% }); %>
                                                <% } %>
                                            </div>
                                            
                                            <% if (character.relationships && character.relationships.length > 0) { %>
                                                <div class="mt-3">
                                                    <h6>Relationships:</h6>
                                                    <small class="text-muted">
                                                        <%= character.relationships.length %> relationship(s)
                                                    </small>
                                                </div>
                                            <% } %>
                                        </div>
                                        <div class="card-footer text-muted small">
                                            ID: <%= character.id %>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
