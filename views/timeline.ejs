<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Timeline</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .sidebar {
            min-height: 100vh;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        .sidebar .nav-link {
            color: rgba(255,255,255,0.8);
        }
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            color: white;
            background-color: rgba(255,255,255,0.1);
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-2 sidebar p-3">
                <h4 class="text-white mb-4"><i class="fas fa-book"></i> Story Planner</h4>
                <ul class="nav flex-column">
                    <li class="nav-item"><a class="nav-link" href="/"><i class="fas fa-home"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/story/settings"><i class="fas fa-cog"></i> Story Settings</a></li>
                    <li class="nav-item"><a class="nav-link" href="/characters"><i class="fas fa-users"></i> Characters</a></li>
                    <li class="nav-item"><a class="nav-link" href="/locations"><i class="fas fa-map-marker-alt"></i> Locations</a></li>
                    <li class="nav-item"><a class="nav-link" href="/lore"><i class="fas fa-scroll"></i> Lore</a></li>
                    <li class="nav-item"><a class="nav-link" href="/events"><i class="fas fa-calendar-alt"></i> Events</a></li>
                    <li class="nav-item"><a class="nav-link" href="/relationships"><i class="fas fa-heart"></i> Relationships</a></li>
                    <li class="nav-item"><a class="nav-link active" href="/timeline"><i class="fas fa-clock"></i> Timeline</a></li>
                    <hr class="text-white">
                    <li class="nav-item"><a class="nav-link" href="/export"><i class="fas fa-download"></i> Export</a></li>
                    <li class="nav-item"><a class="nav-link" href="/import"><i class="fas fa-upload"></i> Import</a></li>
                </ul>
            </div>
            <div class="col-md-10">
                <nav class="navbar navbar-light bg-light">
                    <div class="container-fluid">
                        <span class="navbar-brand mb-0 h1"><%= title %></span>
                    </div>
                </nav>
                <div class="container-fluid p-4">
                    <% if (events.length === 0) { %>
                        <div class="text-center py-5">
                            <i class="fas fa-clock fa-3x text-muted mb-3"></i>
                            <h3 class="text-muted">No Events to Display</h3>
                            <p class="text-muted">Create some events to see your story timeline.</p>
                            <a href="/events/new" class="btn btn-primary">
                                <i class="fas fa-plus"></i> Add Your First Event
                            </a>
                        </div>
                    <% } else { %>
                        <div class="timeline">
                            <% events.forEach(function(event, index) { %>
                                <div class="card mb-3">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <div>
                                            <h5 class="mb-1">
                                                <%= event.title || event.description.substring(0, 50) + '...' %>
                                            </h5>
                                            <small class="text-muted">
                                                <i class="fas fa-calendar"></i> <%= formatTimestamp(event.timestamp) %>
                                            </small>
                                        </div>
                                        <span class="badge bg-primary">#<%= index + 1 %></span>
                                    </div>
                                    <div class="card-body">
                                        <p class="card-text"><%= event.description %></p>
                                        
                                        <% if (event.participants && event.participants.length > 0) { %>
                                            <div class="mb-2">
                                                <strong>Participants:</strong>
                                                <% event.participants.forEach(function(participantId) { %>
                                                    <% const participant = characters.find(c => c.id === participantId); %>
                                                    <span class="badge bg-primary me-1">
                                                        <%= participant ? participant.name : participantId %>
                                                    </span>
                                                <% }); %>
                                            </div>
                                        <% } %>
                                        
                                        <% if (event.location_id) { %>
                                            <div class="mb-2">
                                                <strong>Location:</strong>
                                                <% const location = locations.find(l => l.id === event.location_id); %>
                                                <span class="badge bg-warning text-dark">
                                                    <%= location ? location.name : event.location_id %>
                                                </span>
                                            </div>
                                        <% } %>
                                        
                                        <% if (event.effects && event.effects.length > 0) { %>
                                            <div class="mb-2">
                                                <strong>Effects:</strong>
                                                <span class="badge bg-success"><%= event.effects.length %> effect(s)</span>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
