<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= isEdit ? 'Edit' : 'Add' %> Character</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .sidebar {
            min-height: 100vh;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        .sidebar .nav-link {
            color: rgba(255,255,255,0.8);
        }
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            color: white;
            background-color: rgba(255,255,255,0.1);
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-2 sidebar p-3">
                <h4 class="text-white mb-4">
                    <i class="fas fa-book"></i> Story Planner
                </h4>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            <i class="fas fa-home"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/story/settings">
                            <i class="fas fa-cog"></i> Story Settings
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/characters">
                            <i class="fas fa-users"></i> Characters
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/locations">
                            <i class="fas fa-map-marker-alt"></i> Locations
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/lore">
                            <i class="fas fa-scroll"></i> Lore
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/events">
                            <i class="fas fa-calendar-alt"></i> Events
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/relationships">
                            <i class="fas fa-heart"></i> Relationships
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/timeline">
                            <i class="fas fa-clock"></i> Timeline
                        </a>
                    </li>
                    <hr class="text-white">
                    <li class="nav-item">
                        <a class="nav-link" href="/export">
                            <i class="fas fa-download"></i> Export
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/import">
                            <i class="fas fa-upload"></i> Import
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Main Content -->
            <div class="col-md-10">
                <nav class="navbar navbar-light bg-light">
                    <div class="container-fluid">
                        <span class="navbar-brand mb-0 h1">
                            <%= isEdit ? 'Edit' : 'Add' %> Character
                        </span>
                        <a href="/characters" class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-arrow-left"></i> Back to Characters
                        </a>
                    </div>
                </nav>

                <div class="container-fluid p-4">
                    <div class="row justify-content-center">
                        <div class="col-md-8">
                            <div class="card">
                                <div class="card-header">
                                    <h5>
                                        <i class="fas fa-user"></i> 
                                        <%= isEdit ? 'Edit Character' : 'Create New Character' %>
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <form method="POST" action="<%= isEdit ? '/characters/' + character.id : '/characters' %>">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label for="name" class="form-label">Character Name *</label>
                                                    <input type="text" class="form-control" id="name" name="name" 
                                                           value="<%= character ? character.name : '' %>" required>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label for="age" class="form-label">Age</label>
                                                    <input type="text" class="form-control" id="age" name="age" 
                                                           value="<%= (character && character.attributes && character.attributes.static && character.attributes.static.age) || '' %>">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label for="description" class="form-label">Description</label>
                                            <textarea class="form-control" id="description" name="description" rows="3" 
                                                      placeholder="Describe the character's appearance, personality, background..."><%= character ? character.description : '' %></textarea>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="mb-3">
                                                    <label for="species" class="form-label">Species/Race</label>
                                                    <input type="text" class="form-control" id="species" name="species" 
                                                           value="<%= (character && character.attributes && character.attributes.static && character.attributes.static.species) || '' %>"
                                                           placeholder="Human, Elf, Dwarf...">
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="mb-3">
                                                    <label for="class" class="form-label">Class/Profession</label>
                                                    <input type="text" class="form-control" id="class" name="class" 
                                                           value="<%= (character && character.attributes && character.attributes.static && character.attributes.static.class) || '' %>"
                                                           placeholder="Fighter, Wizard, Merchant...">
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="mb-3">
                                                    <label for="gender" class="form-label">Gender</label>
                                                    <select class="form-control" id="gender" name="gender">
                                                        <option value="">Select Gender</option>
                                                        <option value="Male" <%= (character && character.attributes && character.attributes.static && character.attributes.static.gender === 'Male') ? 'selected' : '' %>>Male</option>
                                                        <option value="Female" <%= (character && character.attributes && character.attributes.static && character.attributes.static.gender === 'Female') ? 'selected' : '' %>>Female</option>
                                                        <option value="Non-binary" <%= (character && character.attributes && character.attributes.static && character.attributes.static.gender === 'Non-binary') ? 'selected' : '' %>>Non-binary</option>
                                                        <option value="Other" <%= (character && character.attributes && character.attributes.static && character.attributes.static.gender === 'Other') ? 'selected' : '' %>>Other</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label for="background" class="form-label">Background</label>
                                            <input type="text" class="form-control" id="background" name="background" 
                                                   value="<%= (character && character.attributes && character.attributes.static && character.attributes.static.background) || '' %>"
                                                   placeholder="City Guard, Forest Hermit, Noble...">
                                        </div>

                                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                            <a href="/characters" class="btn btn-outline-secondary me-md-2">Cancel</a>
                                            <button type="submit" class="btn btn-primary">
                                                <i class="fas fa-save"></i> 
                                                <%= isEdit ? 'Update Character' : 'Create Character' %>
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>

                            <% if (isEdit && character) { %>
                                <div class="card mt-4">
                                    <div class="card-header">
                                        <h5><i class="fas fa-info-circle"></i> Character Information</h5>
                                    </div>
                                    <div class="card-body">
                                        <p><strong>Character ID:</strong> <%= character.id %></p>
                                        <p><strong>Relationships:</strong> <%= character.relationships ? character.relationships.length : 0 %></p>
                                        <p><strong>Dynamic History Entries:</strong> <%= (character.attributes && character.attributes.dynamic_history) ? character.attributes.dynamic_history.length : 0 %></p>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
